{
  "manifest_version": 3,
  "name": "Internet's Dream — Memory Saver",
  "version": "0.1.0",
  "description": "Save pages, selections, and screenshots metadata into your local Internet's Dream memory.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Save to Internet's Dream" },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
