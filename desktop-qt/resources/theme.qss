/* Internet's Dream — Qt6 client, Material 3 Expressive stylesheet
   Palette mirrors web-dashboard/styles.css */

QWidget {
    font-family: "Google Sans", "Segoe UI", "Noto Sans", sans-serif;
    font-size: 14px;
    color: #1c1a2e;
}

QMainWindow, QDialog { background: #faf7ff; }

/* ---------- sidebar rail ---------- */
#rail {
    background: #f4efff;
    border: none;
    border-right: 1px solid #ddd6ee;
    padding: 12px 0;
}
#rail QListWidget::item {
    border-radius: 20px;
    padding: 12px 8px;
    margin: 3px 10px;
    color: #46415c;
}
#rail QListWidget::item:hover { background: #e7e0f4; }
#rail QListWidget::item:selected {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #e4d9ff, stop:1 #e9ddff);
    color: #25005a;
    font-weight: 700;
}

/* ---------- cards ---------- */
QFrame#card {
    background: #ffffff;
    border: 1px solid #e2dbf2;
    border-radius: 24px;
    padding: 18px;
}
QLabel#cardTitle {
    color: #79748f;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
}
QLabel#stat {
    font-size: 34px;
    font-weight: 700;
    color: #6d4bd8;
}
QLabel#statSub { color: #79748f; font-size: 12px; }
QLabel#pageTitle {
    font-size: 28px;
    font-weight: 700;
    color: #1c1a2e;
}
QLabel#pageSub { color: #79748f; font-size: 13px; }

/* ---------- buttons ---------- */
QPushButton {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #6d4bd8, stop:1 #8b5cf6);
    color: white;
    border: none;
    border-radius: 18px;
    padding: 10px 22px;
    font-weight: 600;
    font-size: 13px;
}
QPushButton:hover { background: #5a3cc4; }
QPushButton:pressed { background: #4a2fa8; }
QPushButton:disabled { background: #c9c3de; color: #79748f; }
QPushButton#tonal {
    background: #e4d9ff;
    color: #1e1740;
}
QPushButton#tonal:hover { background: #d9caff; }
QPushButton#outlined {
    background: transparent;
    color: #6d4bd8;
    border: 2px solid #c9c3de;
}
QPushButton#outlined:hover { border-color: #6d4bd8; background: #e9ddff; }
QPushButton#danger {
    background: #ffdad6;
    color: #410002;
}

/* ---------- inputs ---------- */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox {
    background: #f4efff;
    border: 2px solid transparent;
    border-radius: 16px;
    padding: 10px 14px;
    selection-background-color: #e4d9ff;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus {
    border: 2px solid #6d4bd8;
    background: #ffffff;
}

/* ---------- lists ---------- */
QListWidget, QTreeWidget {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget::item {
    border-radius: 14px;
    padding: 8px 10px;
}
QListWidget::item:hover { background: #eee8fb; }
QListWidget::item:selected { background: #e9ddff; color: #25005a; }

/* ---------- scrollbars ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px;
}
QScrollBar::handle:vertical {
    background: #c9c3de;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #79748f; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}
QScrollBar::handle:horizontal {
    background: #c9c3de;
    border-radius: 5px;
    min-width: 30px;
}

/* ---------- status ---------- */
QLabel#chip {
    background: #e4d9ff;
    color: #1e1740;
    border-radius: 14px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
}
QLabel#chipLive {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #e9ddff, stop:1 #ffd9e8);
    color: #25005a;
    border-radius: 14px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
}

/* ---------- chat ---------- */
#chatLog { background: transparent; border: none; }
QTextBrowser#chatLog {
    background: #f4efff;
    border: 1px solid #e2dbf2;
    border-radius: 24px;
    padding: 14px;
}
